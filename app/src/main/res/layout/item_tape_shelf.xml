<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="7dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="5dp"
    app:cardBackgroundColor="@color/tape_dark_body">

    <!-- CASSETTE SHELL -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:background="@drawable/bg_tape_outer"
        android:padding="10dp">

        <!-- INNER COLOR STICKER LABEL (CARD FOR ROUNDED CORNERS) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/panelColor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/paper_cream">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <!-- TITLE & 3-DOT DETAIL BUTTON ROW -->
                <LinearLayout
                    android:id="@+id/layoutTapeHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTapeTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="Tape Title"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="#2A1E17"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <!-- NEAT CIRCULAR 3-DOT DETAIL BUTTON -->
                    <ImageView
                        android:id="@+id/btnTapeMore"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_more_btn_circle"
                        android:padding="5dp"
                        android:src="@drawable/ic_more_vert"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Check Tape Details"/>
                </LinearLayout>

                <!-- CENTER REEL & TAPE WINDOW CONTAINER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- LEFT REEL -->
                    <View
                        android:id="@+id/reelLeft"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_tape_reel" />

                    <!-- CASSETTE TAPE WINDOW (RIBBON VIEWER) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="14dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="12dp"
                        android:background="@drawable/bg_tape_color_preview"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <!-- MAGNETIC TAPE STRIP -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginHorizontal="8dp"
                            android:background="#3B2B23"/>
                    </LinearLayout>

                    <!-- RIGHT REEL -->
                    <View
                        android:id="@+id/reelRight"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_tape_reel" />
                </LinearLayout>

                <!-- DATE & PLAY BADGE AT BOTTOM -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="#6E5C4E"
                        android:layout_marginEnd="4dp"/>

                    <TextView
                        android:id="@+id/tvTapeDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="06 Dec 2025"
                        android:textSize="11sp"
                        android:textColor="#5E4E42"
                        android:textStyle="normal"/>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <!-- TAP TO PLAY HINT -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to listen ▶"
                        android:textSize="10sp"
                        android:textColor="#7A685A"
                        android:textStyle="bold"/>
                </LinearLayout>

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

    </RelativeLayout>
</androidx.cardview.widget.CardView>

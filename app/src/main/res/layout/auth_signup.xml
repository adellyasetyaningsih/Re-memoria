<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="26dp"
    android:background="@color/vintage_background">

    <!-- LOGO -->
    <ImageView
        android:id="@+id/imgSignupLogo"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:src="@drawable/logowmp1"
        android:contentDescription="App Logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- TITLE -->
    <TextView
        android:id="@+id/tvSignupTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create Account"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/imgSignupLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvSignupSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start archiving your voice journal"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/tvSignupTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- EMAIL INPUT -->
    <EditText
        android:id="@+id/etSignupEmail"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="Email address"
        android:background="@drawable/rounded_input"
        android:paddingHorizontal="16dp"
        android:inputType="textEmailAddress"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvSignupSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <!-- PASSWORD INPUT -->
    <EditText
        android:id="@+id/etSignupPassword"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="Password (min 6 characters)"
        android:background="@drawable/rounded_input"
        android:paddingHorizontal="16dp"
        android:inputType="textPassword"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/etSignupEmail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="14dp"/>

    <!-- CONFIRM PASSWORD INPUT -->
    <EditText
        android:id="@+id/etSignupConfirm"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="Confirm Password"
        android:background="@drawable/rounded_input"
        android:paddingHorizontal="16dp"
        android:inputType="textPassword"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/etSignupPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="14dp"/>

    <!-- SIGNUP BUTTON -->
    <Button
        android:id="@+id/btnSignup"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="Create Account"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/fab_wax_red"
        app:cornerRadius="26dp"
        android:elevation="3dp"
        app:layout_constraintTop_toBottomOf="@id/etSignupConfirm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <!-- GO TO LOGIN -->
    <LinearLayout
        android:id="@+id/layoutGoLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/btnSignup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have an account? "
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvGoLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign In"
            android:textColor="@color/accent_gold"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

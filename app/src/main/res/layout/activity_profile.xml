<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vintage_background"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ========== HEADER ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnBackProfile"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Profile"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="18sp" />

            <!-- dummy space -->
            <View
                android:layout_width="28dp"
                android:layout_height="28dp" />
        </LinearLayout>


        <!-- ========== BASIC INFO ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="24dp">

            <ImageView
                android:id="@+id/imgProfilePicture"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:padding="4dp"
                android:src="@drawable/ic_profile_placeholder"
                app:tint="@color/text_primary"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_profile_circle" />

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Your Name"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="email@gmail.com"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>


        <!-- ========== EDIT SECTION ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="26dp"
            android:padding="16dp"
            android:background="@drawable/bg_dialog_round">

            <TextView
                android:text="Profile Info"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- CALLNAME -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Display Name"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/etProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="14sp"
                android:background="@drawable/rounded_input" />

            <!-- ABOUT -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="About you"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/etProfileAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:padding="10dp"
                android:textSize="13sp"
                android:background="@drawable/rounded_input"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary" />

            <Button
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Save Changes"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/accent_gold" />
        </LinearLayout>


        <!-- ========== GOALS SECTION ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:padding="16dp"
            android:background="@drawable/bg_dialog_round">

            <TextView
                android:text="Primary Goals"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Select up to 3 goals that matter most to you"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/layoutGoalChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:flexWrap="wrap"
                app:flexDirection="row" />
        </LinearLayout>


        <!-- ========== REMINDER + DARK MODE ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:padding="16dp"
            android:background="@drawable/bg_dialog_round">

            <TextView
                android:text="Reminder Notification"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- FIXED ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/tvReminderTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="15:00"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/switchReminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/card_stroke" />

            <TextView
                android:text="Dark Mode"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Switch
                android:id="@+id/switchDarkMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />
        </LinearLayout>


        <!-- ========== PASSWORD SECTION ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:padding="16dp"
            android:background="@drawable/bg_dialog_round">

            <Button
                android:id="@+id/btnTogglePasswordForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Change Password"
                android:textAllCaps="false"
                android:backgroundTint="@color/wood_brown"
                android:textColor="@android:color/white" />

            <LinearLayout
                android:id="@+id/layoutPasswordForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etCurrentPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Current password"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:inputType="textPassword"
                    android:padding="10dp"
                    android:background="@drawable/rounded_input" />

                <EditText
                    android:id="@+id/etNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="New password"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:inputType="textPassword"
                    android:padding="10dp"
                    android:background="@drawable/rounded_input" />

                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Confirm new password"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:inputType="textPassword"
                    android:padding="10dp"
                    android:background="@drawable/rounded_input" />

                <Button
                    android:id="@+id/btnDoChangePassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Change"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/wood_brown"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </LinearLayout>


        <!-- ========== ACCOUNT ACTIONS ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:padding="16dp"
            android:background="@drawable/bg_dialog_round">

            <Button
                android:id="@+id/btnDeleteAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delete Account"
                android:layout_marginBottom="10dp"
                android:backgroundTint="@color/brick_red"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:backgroundTint="@color/fab_wax_red"
                android:textColor="@android:color/white" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>

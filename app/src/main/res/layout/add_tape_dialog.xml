<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:orientation="vertical"
        android:padding="22dp"
        android:background="@drawable/bg_dialog_round"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnCloseDialog"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="7dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/text_primary"
                android:contentDescription="Close" />

            <TextView
                android:id="@+id/tvAddTapeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Record New Memory"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <View
                android:layout_width="34dp"
                android:layout_height="34dp"/>
        </LinearLayout>

        <!-- CASSETTE TAPE PREVIEW (BALANCED PROPORTIONS - NOT GEPENG) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/tape_dark_body">

            <LinearLayout
                android:id="@+id/tapePreview"
                android:layout_width="match_parent"
                android:layout_height="124dp"
                android:layout_margin="8dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:background="#EEC373">

                <!-- CASSETTE TOP BADGE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIDE A  •  STEREO TAPE"
                    android:textSize="9sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"
                    android:textColor="#5A483E"/>

                <!-- CASSETTE TITLE PREVIEW -->
                <TextView
                    android:id="@+id/tvTapeCaptionPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Tape Title"
                    android:textColor="#2B1F18"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- REELS & WINDOW WITH AMPLE SPACING -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_tape_reel" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="16dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="12dp"
                        android:background="@drawable/bg_tape_color_preview"
                        android:gravity="center">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginHorizontal="6dp"
                            android:background="#3B2B23"/>
                    </LinearLayout>

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_tape_reel" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- PALETTE COLOR OPTIONS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose Tape Shell Color"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="16dp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/layoutColorOptions"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- SWATCH 1 -->
            <androidx.cardview.widget.CardView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_margin="4dp"
                app:cardCornerRadius="19dp"
                app:cardElevation="2dp">
                <View android:id="@+id/color1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#EEC373"/>
            </androidx.cardview.widget.CardView>

            <!-- SWATCH 2 -->
            <androidx.cardview.widget.CardView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_margin="4dp"
                app:cardCornerRadius="19dp"
                app:cardElevation="2dp">
                <View android:id="@+id/color2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#B9A27A"/>
            </androidx.cardview.widget.CardView>

            <!-- SWATCH 3 -->
            <androidx.cardview.widget.CardView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_margin="4dp"
                app:cardCornerRadius="19dp"
                app:cardElevation="2dp">
                <View android:id="@+id/color3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#D7C4B3"/>
            </androidx.cardview.widget.CardView>

            <!-- SWATCH 4 -->
            <androidx.cardview.widget.CardView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_margin="4dp"
                app:cardCornerRadius="19dp"
                app:cardElevation="2dp">
                <View android:id="@+id/color4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#F8ECDD"/>
            </androidx.cardview.widget.CardView>

            <!-- SWATCH 5 -->
            <androidx.cardview.widget.CardView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_margin="4dp"
                app:cardCornerRadius="19dp"
                app:cardElevation="2dp">
                <View android:id="@+id/color5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#C27A6A"/>
            </androidx.cardview.widget.CardView>

            <!-- SWATCH 6 -->
            <androidx.cardview.widget.CardView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_margin="4dp"
                app:cardCornerRadius="19dp"
                app:cardElevation="2dp">
                <View android:id="@+id/color6"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#8B5E3C"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- CAPTION INPUT -->
        <EditText
            android:id="@+id/etTapeCaption"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="What's on your mind today?"
            android:textColorHint="@color/text_tertiary"
            android:textColor="@color/text_primary"
            android:background="@drawable/rounded_input"
            android:paddingHorizontal="14dp"
            android:textSize="14sp"
            android:maxLines="1"
            android:inputType="textCapSentences" />

        <!-- RECORD TIMER & STATUS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvRecordStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ready to record"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- AUDIO PREVIEW PLAYER (VISIBLE AFTER RECORDING) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutPreviewPlayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_circle_button"
                    android:src="@drawable/ic_play"
                    android:padding="9dp"
                    android:contentDescription="Play or Pause preview"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recorded Audio"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:id="@+id/tvPreviewDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <!-- RETAKE BUTTON -->
                <Button
                    android:id="@+id/btnRetake"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Retake"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/card_stroke"
                    app:cornerRadius="18dp"
                    android:textAllCaps="false"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ACTION RECORD / SAVE BUTTON -->
        <Button
            android:id="@+id/btnStartRecord"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:text="Start Recording"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/fab_wax_red"
            app:cornerRadius="26dp"
            android:elevation="4dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_margin="2dp"
    android:clickable="true"
    android:focusable="true">

    <!-- 1. CELL BACKGROUND (TINTED TO TAPE COLOR ON RECORDED DAYS) -->
    <View
        android:id="@+id/viewTapeShell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_calendar_tape" />

    <!-- 2. DATE NUMBER & TAPE INDICATOR PILL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/tvDayNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <!-- Aesthetic tape memory indicator pill -->
        <View
            android:id="@+id/viewTapeDot"
            android:layout_width="14dp"
            android:layout_height="3.5dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/bg_tape_ribbon_indicator"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 3. SELECTED DAY BORDER HIGHLIGHT (ALWAYS CRISP & VISIBLE) -->
    <View
        android:id="@+id/viewSelectedBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_calendar_tape_selected_border"
        android:visibility="gone" />

</FrameLayout>
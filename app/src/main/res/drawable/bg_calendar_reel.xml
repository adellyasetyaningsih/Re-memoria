<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer reel disc -->
    <item>
        <shape android:shape="oval">
            <size android:width="12dp" android:height="12dp"/>
            <solid android:color="#FFFDF8"/>
            <stroke android:width="1.5dp" android:color="#4A382E"/>
        </shape>
    </item>

    <!-- Center spindle hole -->
    <item android:top="3.5dp" android:bottom="3.5dp" android:left="3.5dp" android:right="3.5dp">
        <shape android:shape="oval">
            <solid android:color="#4A382E"/>
        </shape>
    </item>
</layer-list>

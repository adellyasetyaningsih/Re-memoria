<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow -->
    <item>
        <shape>
            <solid android:color="#A58A62" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Main brass panel -->
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape>
            <gradient
                android:startColor="#CBB88A"
                android:centerColor="#D9C9A3"
                android:endColor="#B39971"
                android:angle="90" />
            <stroke android:width="3dp" android:color="#3A2B20"/>
            <corners android:radius="18dp" />
            <padding android:top="10dp" android:bottom="10dp"/>
        </shape>
    </item>

    <!-- Inner glowing border -->
    <item android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp">
        <shape>
            <stroke android:width="1dp" android:color="#E8DCC0"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

</layer-list>
